# Copy to .env and fill in what you have. Everything is optional:
# anything missing falls back gracefully and the status bar at the bottom of the app says so.

# Server
PORT=3000
PUBLIC_URL=http://localhost

# Solana (devnet)
SOLANA_RPC=https://api.devnet.solana.com
PROGRAM_ID=
DEMO_USD_PER_SOL=10000
# DEADLOCK_MOCK=1   # fake the chain for local testing

# Vultr Serverless Inference (OpenAI-compatible)
VULTR_INFERENCE_KEY=
VULTR_MODEL=

# Backup LLM (any OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Snowflake (key-pair auth; open /setup for the SQL)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Trial accounts can only send preset templates, e.g. sms_appointment_reminders
TWILIO_TEMPLATE=

# Demo people
FAMILY_PHONE=
SENIOR_NAME=Rose Alvarez
FAMILY_NAME=Maya Alvarez
